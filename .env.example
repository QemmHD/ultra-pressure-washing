# Ultra Pressure Washing backend configuration
#
# Copy this file to .env only for local development. Never place real
# production credentials in this example, source control, netlify.toml, or a
# VITE_ variable. Production server values belong in Netlify's environment
# settings with Functions scope and the explicitly approved deploy context.

# ---------------------------------------------------------------------------
# Public browser configuration
# ---------------------------------------------------------------------------
# These values are intentionally public and are used only for Supabase Auth.
# Leave them blank to keep /admin fail-closed in local and preview builds.
VITE_SUPABASE_PROJECT_REF=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ADMIN_AUTH_ENABLED=false
VITE_STAGING_BACKEND_ENABLED=false
VITE_STAGING_PREVIEW_ORIGIN=
VITE_ADMIN_PASSWORD_RECOVERY_ENABLED=false

# Only the exact value "live" enables the production quote path. A separately
# approved staging rehearsal uses VITE_STAGING_BACKEND_ENABLED plus an exact
# deploy-preview origin; ordinary local, branch, and deploy-preview builds stay
# non-sending.
VITE_QUOTE_MODE=preview

# ---------------------------------------------------------------------------
# Server-only Netlify Function configuration
# ---------------------------------------------------------------------------
# Never prefix these values with VITE_.
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

STAGING_BACKEND_ENABLED=false
ADMIN_BACKEND_ENABLED=false
ADMIN_ALLOWED_ORIGIN=https://ultrapressurewashing.net
QUOTE_ALLOWED_ORIGIN=https://ultrapressurewashing.net
EXPECTED_NETLIFY_SITE_ID=
QUOTE_IP_HASH_SECRET=
QUOTE_SUBMISSION_ENABLED=false

CHARIOT_ENABLED=false
CHARIOT_FORM_ENDPOINT=https://chariotai.com/api/forms/submit
CHARIOT_FORM_TOKEN=

NTFY_ENABLED=false
NTFY_TOPIC=
NTFY_ACCESS_TOKEN=

# Optional future anti-spam integration. Keep disabled until separately
# approved and configured in both the public client and server Function.
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
